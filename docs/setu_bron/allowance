Example JSON message Overtime Compensation (combined money and time)
Collapse
Copy
{
  "allowance": [
    {
      "id": {
        /* Unique identifier for this specific allowance regulation */
        "value": "23asdfva32e",
        "schemeAgencyId": "Customer"
      },
      "name": "Overtime Compensation (Money and Time)",
      "origin": {
        /* Specifies the legal source of the arrangement, e.g., a CLA (CAO) */
        "type": "CollectiveLabourAgreement"
      },
      "effectivePeriod": {
        /* Overall validity period for this allowance rule */
        "validFrom": "2025-01-01",
        "validTo": "2025-12-31"
      },
      "typeCode": {
        /* Standardized classification code for overtime */
        "value": "HT200"
      },
      "period": [
        {
          /* Window of applicability: Date range, time range, and specific weekdays */
          "datePeriod": [
            {
              "start": "2025-01-01",
              "end": "2025-12-31"
            }
          ],
          "timePeriod": {
            /* Overtime window: from 6:00 PM until 6:00 AM the next morning */
            "start": "18:00:00",
            "end": "06:00:00"
          },
          "weekday": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ]
        }
      ],
      "line": [
        {
          /* Method 1: Monetary compensation (150% surcharge) */
          "lineId": {
            "value": "LINE-OT-MONEY"
          },
          "amount": {
            "value": 150.0,
            "unitCode": "Percentage",
            "baseAmount": {
              /* The 150% is calculated over the Gross Hourly Rate */
              "unitCode": "HourlyRate",
              "baseType": "GrossSalary"
            },
            "proportional": {
              /* Mandatory v2.0 field: indicates the rate isn't adjusted based on part-time factor */
              "partTimePercentage": false,
              "employmentDuration": false
            }
          },
          "intervalCode": {
            /* Rate is applied for every 1 hour of overtime worked */
            "value": "1",
            "unitCode": "Hour"
          },
          "conditions": [
            {
              /* Functional filter: this monetary line only applies to TeamLeads */
              "conditionType": "PositionProfile",
              "operator": "in",
              "positionProfileIds": ["TeamLead"]
            }
          ]
        },
        {
          /* Method 2: Time-for-time compensation (1 hour worked = 1 hour leave) */
          "lineId": {
            "value": "LINE-OT-TIME"
          },
          "amount": {
            "value": 1.0,
            "unitCode": "Hour",
            "baseAmount": {
              /* Indicates a fixed ratio (1:1) rather than a percentage calculation */
              "unitCode": "Fixed"
            },
            "proportional": {
              "partTimePercentage": false,
              "employmentDuration": false
            }
          },
          "intervalCode": {
            "value": "1",
            "unitCode": "Hour"
          }
        }
      ]
    }
  ]
}
