Example JSON message public holiday surcharge
Collapse
Copy
{
  "allowance": [
    {
        "id": {
            /* Unique identifier for this holiday regulation */
            "value": "2b497d33fs",
            "schemeAgencyId": "Customer"
        },
        "name": "Public Holiday Surcharge",
        "origin": {
            /* Source of the arrangement, e.g., a Sector CLA */
            "type": "CollectiveLabourAgreement"
        },
        "effectivePeriod": {
            "validFrom": "2026-01-01",
            "validTo": "2027-12-31"
        },
        "typeCode": {
            /* HT340 is the standard code for Public Holiday surcharges */
            "value": "HT340"
        },
        "period": [
            {
                /* You can define specific dates and the time on that date for the holidays */
                "timePeriod": {
                    "start": "00:00:00",
                    "end": "23:59:59"
                },
                /* IMPORTANT: The 'Holiday' enum allows logic based on a holiday calendar. These are the holidays specified under Leave */
                "weekday": [ "Holiday" ]
            }
        ],
        "line": [
            {
                "lineId": {
                    "value": "LINE-HOL-001"
                },
                "amount": {
                    "value": 200.0,
                    "unitCode": "Percentage",
                    "baseAmount": {
                        /* 200% charge calculated over the standard Hourly Rate */
                        "unitCode": "HourlyRate",
                        "baseType": "RegularWage"
                    }
                },
                "intervalCode": {
                    /* Applied for every 1 hour worked on the holiday */
                    "value": "1",
                    "unitCode": "Hour"
                }
            }
        ],
        "reference": [
            {
                "typeCode": "HT320",
                "description": "Calculated cumulatively with shift allowances (percentages are added up)",
                "relationType": "Cumulative"
            }
        ]
    }
  ]
}
