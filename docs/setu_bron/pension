              /* Mandatory v2.0 field: Pension accrual follows salary/hours worked */
              "partTimePercentage": true,
              "employmentDuration": true,
              "description": "Contribution is proportional to the actual pensionable earnings."
            }
          },
          "intervalCode": {
            /* Pension calculations are typically determined on an annual basis */
